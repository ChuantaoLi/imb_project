<dc:format>application/pdf</dc:format>
<dc:title>A multiclass classification using one-versus-all approach with the differential partition sampling ensemble</dc:title>
<dc:creator>
   <rdf:Seq>
     <rdf:li>Xin Gao</rdf:li>
     <rdf:li>Yang He</rdf:li>
     <rdf:li>Mi Zhang</rdf:li>
     <rdf:li>Xinping Diao</rdf:li>
     <rdf:li>Xiao Jing</rdf:li>
     <rdf:li>Bing Ren</rdf:li>
     <rdf:li>Weijia Ji</rdf:li>
   </rdf:Seq>
</dc:creator>
<dc:subject>
   <rdf:Bag>
     <rdf:li>Multiclass classification</rdf:li>
     <rdf:li>One-versus-all</rdf:li>
     <rdf:li>Class imbalance</rdf:li>
     <rdf:li>Differential partition sampling</rdf:li>
     <rdf:li>Ensemble learning</rdf:li>
   </rdf:Bag>
</dc:subject>
<dc:description>Engineering Applications of Artificial Intelligence, 97 (2021) 104034. doi:10.1016/j.engappai.2020.104034</dc:description>
